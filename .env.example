# Copy this file to .env and fill in the required value.
#
#   cp .env.example .env
#
# Never commit the real .env: it contains the application secret.

# Required. Generate one with:
#   openssl rand -base64 48
# or, inside the ui directory:
#   mix phx.gen.secret
SECRET_KEY_BASE=replace-with-a-long-random-secret

# Public host name (or IP address) used to build absolute URLs.
PHX_HOST=localhost

# Address and port published by docker compose. Use 127.0.0.1 when a reverse
# proxy runs on the same host; use 0.0.0.0 for direct access.
BIND_ADDRESS=0.0.0.0
HOST_PORT=4000

# URL scheme and port generated by Phoenix. If a TLS-terminating reverse proxy
# forwards to this container, use https and 443 and set FORCE_SSL=true below.
PHX_SCHEME=http
PHX_URL_PORT=4000

# Set to true when a reverse proxy terminates TLS. This is a build-time option:
# rebuild the image with `docker compose build` after changing it.
FORCE_SSL=false

# Safety / deadlock analysis limits.
SIFT_MAX_STATES=200000
SIFT_TIMEOUT=15
